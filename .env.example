# Copy to .env — never commit real secrets. Quote values containing spaces.
PLATFORM_NAME="Nexora"
SECRET_KEY=generate-a-long-random-string
# SQLite by default (zero external services). For Postgres use:
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./dev.db
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# "development" enables /docs + localhost CORS; production omits both
ENVIRONMENT=development

# Baked into the frontend bundle at BUILD time. With a domain use the public URL:
#   NEXT_PUBLIC_API_URL=https://app.example.com/api
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_PLATFORM_NAME="Nexora"
# Secret admin console path: panel lives at /nx/<this>. Auto-generated if left empty.
NEXT_PUBLIC_ADMIN_PATH=

# Your public domain — Caddy gets HTTPS automatically when set (deploy/install.sh)
DOMAIN=

# Admin console credentials — admins log in with ADMIN_ID (not an email).
# install.sh auto-generates strong values if these are left as defaults.
ADMIN_ID=admin
ADMIN_EMAIL=admin@internal.local
ADMIN_PASSWORD=admin1234

# Brevo transactional email (preferred) — OTP verification, resets, notifications.
# Get an API key from brevo.com → SMTP & API → API Keys. Sender must be verified.
BREVO_API_KEY=
MAIL_FROM=info@yourdomain.com
MAIL_FROM_NAME=Your Platform

# SMTP fallback — used only when BREVO_API_KEY is empty.
# Leave both empty to keep dev mode (codes echoed in API responses).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
